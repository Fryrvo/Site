---
const team = [
  {
    name: 'Fryrvo Fox',
    image: 'https://cdn.fryrvo.com/assets/fryrvo/fryrvo.png',
    job: 'Person',
  },
  {
    name: 'Cath',
    image: '/assets/team-2.webp',
    job: 'Person',
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="sm:space-8 space-y-12">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Person</h2>




          <img
            class="h-[100px] w-[200px] rounded-3xl object-contain"
            src="https://cdn.fryrvo.com/assets/fryrvo/Logo_bg.png"
            alt="icon"
          />

          <h1 class="text-4xl font-medium tracking-tight sm:text-5xl lg:text-6xl">
            text
          </h1>

          <p class="text-primary-950/70 dark:text-primary-200/70 text-lg sm:text-xl">
            text
          </p>

      <ul role="list" class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">



        {
          team.map((item) => (
            <li class="border-primary-900/10 dark:border-primary-300/10 rounded-3xl border px-6 py-8">
              <div class="space-y-6">
                <img class="mx-auto h-auto w-16 rounded-full" src={item.image} alt={item.name} />
                <div class="text-center">
                  <h3 class="text-lg font-medium">{item.name}</h3>
                  <p class="text-primary-950/70 dark:text-primary-200/70 text-base">{item.job}</p>
                </div>
              </div>
            </li>
          ))
        }




      </ul>
    </div>
  </div>
</section>
