---
import Layout from '~/stage/layouts/Layout.astro';
import "@fancyapps/ui/dist/fancybox/fancybox.css";

const R2_PUBLIC_URL = "https://database.fryrvo.com";

const videoFiles = [
  "video1.mp4",
];

const videoUrls = videoFiles.map(file => `${R2_PUBLIC_URL}/${file}`);
---

<Layout
  title="Videos"
  description="Video gallery"
>
  <section class="video-grid">
    {
      videoUrls.map((url) => (
        <div class="video-card">
          <a 
            href={url} 
            data-fancybox="gallery" 
            data-type="html5video"
          >
            <video
              src={url}
              muted
              playsinline
              preload="metadata"
            />
            <div class="play-overlay">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </a>
        </div>
      ))
    }
  </section>
</Layout>

<script>
  import { Fancybox } from "@fancyapps/ui";

  const initLightbox = () => {
    Fancybox.bind("[data-fancybox]", {
      dragToClose: false,
      Html5video: {
        autoplay: true,
      },
    });
  };

  initLightbox();
  document.addEventListener("astro:page-load", initLightbox);
</script>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    padding: 24px;
  }

  .video-card {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease;

    &:hover {
      transform: translateY(-4px);
    }

    a {
      display: block;
      width: 100%;
      height: 100%;
    }

    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .play-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    pointer-events: none;

    svg {
      width: 48px;
      height: 48px;
      fill: #ffffff;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    }
  }

  .video-card:hover .play-overlay {
    background: rgba(0, 0, 0, 0.5);
  }
</style>