---
import Layout from '../../layouts/Layout.astro';

let rawReleases = [];
try {
  // Use relative globbing path so Vite resolves the files reliably in Astro v5
  rawReleases = await Astro.glob('../../components/music/*.{md,mdx}');
} catch (e) {
  rawReleases = [];
}

const releases = rawReleases
  .map((r) => {
    // Extract file name without extension to construct a clean fallback slug
    const fileName = r.file.split('/').pop()?.replace(/\.(md|mdx)$/, '');
    const data = r.frontmatter || r.data || {};
    
    // Determine the path to route to your [...slug].astro page
    const slug = data.slug || fileName;
    const href = r.url || `/music/${slug}`;

    return {
      ...r,
      data,
      href,
    };
  })
  .sort((a, b) => {
    const dateA = new Date(a.data.date || 0).getTime();
    const dateB = new Date(b.data.date || 0).getTime();
    return dateB - dateA;
  });
---

<Layout title="Releases · Music" description="Discography and latest releases">
  <header class="py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:max-w-7xl lg:px-8">
      <h1 class="text-4xl font-medium tracking-tight sm:text-5xl lg:text-6xl">Releases</h1>
      <p class="text-primary-950/70 dark:text-primary-200/70 mx-auto mt-4 max-w-xl text-lg sm:text-xl">
        FryrvoMusic Releases
      </p>
    </div>
  </header>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        {
          releases.map((item) => (
            <a href={item.href} class="group flex flex-col focus:outline-none">
              <!-- Square Album Art Cover -->
              <div class="bg-primary-500/10 dark:bg-primary-400/10 border-primary-900/10 dark:border-primary-300/10 aspect-square w-full overflow-hidden rounded-md border shadow-sm transition-transform duration-200 group-hover:scale-[1.02]">
                {item.data.cover || item.data.image ? (
                  <img
                    src={item.data.cover || item.data.image}
                    alt={item.data.title || 'Album Cover'}
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div class="flex h-full items-center justify-center text-xs opacity-40">
                    No Cover
                  </div>
                )}
              </div>

              <!-- Release Metadata -->
              <div class="mt-3 flex flex-col">
                <h2 class="text-base font-medium tracking-tight truncate group-hover:underline">
                  {item.data.title || 'Untitled Release'}
                </h2>
                
                <div class="text-primary-950/60 dark:text-primary-200/60 flex items-center gap-1.5 text-xs">
                  <span>{item.data.type || 'Release'}</span>
                  {item.data.date && (
                    <>
                      <span>•</span>
                      <span>{new Date(item.data.date).getFullYear()}</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>