---
const stats = [
  {
    name: 'box',
    value: 'tings in an box',
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <img
        class="mx-auto h-auto w-full max-w-xl rounded-3xl"
        width="576"
        height="600"
        src="https://cdn.fryrvo.com/assets/fryrvo_branding/Fryrvo_nobg.png"
        alt="Fryrvo(Cath) icon"
      />
      <div class="flex flex-col gap-10">

        <!-- Mission description -->
        <div class="space-y-5 sm:space-y-12">
          <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Hello</h2>
          <div class="space-y-4">
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
             Hi I'm cath I assume that you are here not because you are testing stuff just using stuff here 
             <br>
             Well don't worries much about me it get the job done and that is all you need to know
             <br>
             Want to know more? You can use contact form below or say hi to contact@fryrvo.com
             <br>
             <br>
             ps sorry if I missed spelled something it probably a lot
            
            </p>
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
              
            </p>
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
              SOON™
            </p>
          </div>
        </div>

        
        <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            stats.map((stat) => (
              <div class="border-primary-900/10 dark:border-primary-300/10 rounded-3xl border p-6">
                <dt class="text-base">{stat.name}</dt>
                <dd class="text-3xl font-medium tracking-tight">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>

</section>
